diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000..a3c90b0
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,37 @@
+'use strict';
+
+// Bound every recursive walker independently of caller-controlled options.
+const MAX_DEPTH = 128;
+
+const checkDepth = depth => {
+  if (depth > MAX_DEPTH) {
+    const error = new RangeError(`Brace nesting exceeds maximum depth (${MAX_DEPTH})`);
+    error.code = 'ERR_BRACES_DEPTH';
+    throw error;
+  }
+};
+
+const validateDepth = (ast, checkParents = false) => {
+  const pending = [{ node: ast, depth: 0 }];
+  while (pending.length > 0) {
+    const { node, depth } = pending.pop();
+    if (!node || !node.nodes) continue;
+    checkDepth(depth);
+
+    // expand also follows parent links on externally supplied ASTs.
+    if (checkParents) {
+      let parent = node;
+      let parentDepth = 0;
+      while (parent.type !== 'brace' && parent.type !== 'root' && parent.parent) {
+        checkDepth(++parentDepth);
+        parent = parent.parent;
+      }
+    }
+
+    for (const child of node.nodes) {
+      pending.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
+
+module.exports = { checkDepth, validateDepth };
